# Corner case: DRAINING-EVENT RESIDUAL READ (gh#217).
#
# A live transition DRAINS A every substep while an always-active DRAINING event
# (a value-dependent fraction transfer A --> C) ALSO reads A. The event delta is
# floor(residual_A * f), so it DIFFERS depending on whether the event reads A
# before or after the substep's drain:
#
#   drain : A --> B @ k * A            (nonzero per-capita rate: A leaks to B)
#   leak  : transfer(fraction = f, from = A, to = C)   every substep
#
# Semantics (all backends agree): a DRAINING event reads the POST-TRANSITION
# RESIDUAL A — what survived the substep's drain — and moves a fraction of that.
# This matches continuous-time ground truth: the drain hazard acts OVER the
# interval, the transfer is a point operation AT the boundary on the survivors.
# ode (RK4) and gillespie (SSA) already read live/post-advance state;
# chain_binomial joins them (gh#217 — it previously fused the draining transfer
# against the start-of-step snapshot, which double-counted the drained
# individuals and could overshoot to a negative count when f -> 1).
#
# INFLOW events (`add`) keep the start-of-step snapshot, fused atomically with
# the transition draw — only DRAINING actions read the residual.
#
# ode (RK4) and gillespie (SSA) have different kernels, so they do NOT byte-match
# chain here; they get their own pinned baselines in gate_corner_case_baseline.
time_unit = 'days

compartments { A, B, C }

parameters {
  k : rate        in [0.0, 1.0]
  f : probability in [0.0, 1.0]
}

transitions {
  drain : A --> B  @ k * A
}

events {
  # Start at t=1 (not t=0): chain_binomial's step_one keys events to the END of
  # each step and never fires at t=0, so starting the leak at t=1 lines the event
  # cadence up across backends — keeping this fixture about the read-source
  # (residual vs snapshot) rather than a boundary-cadence difference.
  leak : transfer(fraction = f, from = A, to = C) {
    every = 1 'days
    from  = 1
  }
}

init {
  A = 500
  B = 0
  C = 0
}

simulate {
  from = 0 'days
  to   = 20 'days
}
